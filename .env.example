# Configuration — Copiez ce fichier en .env et remplissez vos valeurs
# Ne jamais committer le fichier .env

# n8n MCP Server
N8N_BASE_URL=https://mapey.app.n8n.cloud
N8N_API_KEY=your_n8n_api_key_here

# GitHub MCP Server
# Créer un token sur : https://github.com/settings/tokens
# Permissions requises : repo, read:packages, read:org
GITHUB_TOKEN=your_github_personal_access_token_here
